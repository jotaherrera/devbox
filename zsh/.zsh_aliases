#!/bin/zsh
# 🚀 ZSH Aliases - Juan Herrera

# 🌍 Environment
export EDITOR="cursor --wait"
export GIT_EDITOR="nano"

# ⚙️ ZSH
alias zshrc="$EDITOR ~/.zshrc"
alias srcz="source ~/.zshrc"

# 🔧 Git functions
cgp() {
  git push origin "$1"
}

cgpf() {
  git push --force origin "$1"
}

cgpm() {
  git pull --autostash --progress --rebase --stat origin "$1"
}

dpg() {
  cgpm "$1" && cgp "$1"
}                                           

# Git aliases
alias dpg="cgpm && cgpf"
alias cpb="change-preferred-branch"
alias cpmb="change-preferred-main-branch"

# 📁 Navigation
mkcd() {
  mkdir -p "$1" && cd "$1"
}
alias cdw="cd ~/Development"

# 🧹 System commands
alias cls="clear"
alias rm="rm -iv"
alias rma="rm -Iv"
alias mv="mv -i"
alias cp="cp -i"
alias rmdir="rm -riv"
alias rmadir="rm -rIv"