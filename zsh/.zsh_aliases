#!/bin/zsh
# 🚀 ZSH Aliases - Juan Herrera

# 🌍 Environment
export EDITOR="cursor --wait"
export GIT_EDITOR="nano"
export GIT_PREFERRED_BRANCH="jotaherrera"
export GIT_PREFERRED_MAIN_BRANCH="trunk"

# ⚙️ ZSH
alias zshrc="$EDITOR ~/.zshrc"
alias srcz="source ~/.zshrc"

# 🔧 Git functions
cgp() {
  git push origin "$GIT_PREFERRED_BRANCH"
}

cgpf() {
  git push --force origin "$GIT_PREFERRED_BRANCH"
}

cgpm() {
  git pull --autostash --progress --rebase --stat origin "$GIT_PREFERRED_MAIN_BRANCH"
}

alias dpg="cgpm && cgp"                                              

# Git branch management functions
change-preferred-branch() {
  export GIT_PREFERRED_BRANCH="$1"
  echo "Preferred branch set to: $GIT_PREFERRED_BRANCH"
}

change-preferred-main-branch() {
  export GIT_PREFERRED_MAIN_BRANCH="$1"
  echo "Preferred main branch set to: $GIT_PREFERRED_MAIN_BRANCH"
}

# Git aliases
alias dpg="cgpm && cgp"
alias cpb="change-preferred-branch"
alias cpmb="change-preferred-main-branch"

# 📁 Navigation
mkcd() {
  mkdir -p "$1" && cd "$1"
}
alias cdw="cd ~/Development"

# 🧹 System commands
alias cls="clear"
alias rm="rm -iv"
alias rma="rm -Iv"
alias mv="mv -i"
alias cp="cp -i"
alias rmdir="rm -riv"
alias rmadir="rm -rIv"